{
  "name": "kidwrangler",
  "version": "0.1.0",
  "private": true,
  "description": "Voice-driven, screen-free kids' games. Capacitor app — built from prototype.html.",
  "scripts": {
    "dev": "npx serve www -l 5173",
    "sync": "cap sync",
    "android": "cap run android",
    "ios": "cap run ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "build:web": "echo \"No build step — vanilla JS. www/ is the build output.\"",
    "icons": "capacitor-assets generate --assetPath www/icons-source"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@capacitor-community/keep-awake": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "serve": "^14.2.4"
  }
}
