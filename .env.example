# KidWrangler — local secrets template.
#
# Copy this file to `.env` (same directory, no extension) and fill in your
# real values. `.env` is gitignored so credentials stay on your machine.
#
#   PowerShell:  Copy-Item .env.example .env
#   bash/zsh:    cp .env.example .env
#
# The voice-generator script (`node app/scripts/generate-voices.mjs`)
# auto-loads this file at startup. No npm install needed — the loader is
# inline in the script.
#
# After editing, you can just run:
#   node app/scripts/generate-voices.mjs --tier system
# (no need to also pass --voice or set env vars manually).

# ─── ElevenLabs ──────────────────────────────────────────────────────
# API key from https://elevenlabs.io/app/settings/api-keys (starts with "sk_")
ELEVENLABS_API_KEY=sk_paste_your_key_here

# Voice ID from your VoiceLab — open the voice and copy the ID string.
# Looks like a 20-character alphanumeric, e.g. 21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_ID=paste_voice_id_here

# Optional — uncomment to change defaults. The script falls back to these
# if the corresponding --flag isn't passed.
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Cheap alternative: eleven_turbo_v2_5  (~50% the cost, slightly lower quality)
